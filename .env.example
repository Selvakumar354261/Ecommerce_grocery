COMPOSE_PROJECT_NAME=grocery_commerce
APP_PORT=8080
POSTGRES_DB=grocery
POSTGRES_USER=grocery
POSTGRES_PASSWORD=local-only-change-this-password
# Local testing only: creates admin@test.com / 1234567890, no demo data.
# Never resets an existing administrator.
SEED_ADMIN_ONLY=false
# true: only admin can sign in. Customer OTP, registration, delivery app,
# and manager/cashier/inventory logins are all blocked. Set false to re-enable them.
ADMIN_LOGIN_ONLY=true
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
RESERVATION_MINUTES=30
